{
  "name": "parcel-typescript-react-tailwind",
  "version": "5.0.0",
  "description": "Trying-out Tailwind CSS with Parcel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "parcel serve src/index.html -p 8080 --open",
    "build": "parcel build --dist-dir dist src/index.html",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf .parcel-cache dist",
    "serve": "pnpm exec serve dist",
    "start": "pnpm clean && pnpm build && pnpm serve"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@parcel/transformer-image": "2.16.4",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "parcel": "2.16.4",
    "postcss": "^8.5.26",
    "serve": "14.2.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.28.11"
}
